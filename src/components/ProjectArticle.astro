---
import { metricLine, type ProjectView } from "../lib/content";
import type { UI } from "../i18n/ui";

interface Props {
  project: ProjectView;
  t: UI;
  /** tile: a live product. row: one line in the open-source list. study: the case-study page. */
  mode?: "tile" | "row" | "study";
}

const { project, t, mode = "tile" } = Astro.props;
const facts = metricLine(project);
---

{
  mode === "tile" && (
    <article class="tile" id={project.slug}>
      <img class="tile-icon" src="/assets/brand/icon.svg" width="72" height="72" alt="" />
      <div>
        <h3 translate="no"><a href={project.href}>{project.title}</a></h3>
        <p>{project.summary}</p>
        {facts && <p class="quiet">{facts}</p>}
        <p class="text-links">
          {project.live && <a href={project.live}>{t.openMap}</a>}
          <a href={project.href}>{t.caseStudy}</a>
        </p>
      </div>
    </article>
  )
}

{
  mode === "row" && (
    <li class="oss-item" id={project.slug}>
      <h3 translate="no"><a href={project.href}>{project.title}</a></h3>
      <p>{project.summary}</p>
      {facts && <p class="quiet">{facts}</p>}
      <p class="text-links">
        {project.repo && <a href={project.repo}>{t.github}</a>}
        <a href={project.href}>{t.caseStudy}</a>
      </p>
    </li>
  )
}

{
  mode === "study" && (
    <article class="study" id={project.slug}>
      <p class="kicker">{project.kind === "product" ? t.live : t.openSource}</p>
      <h1 translate="no">{project.title}</h1>
      <p class="lede">{project.summary}</p>
      {facts && <p class="quiet">{facts}</p>}
      <p class="text-links">
        {project.live && <a href={project.live}>{t.openMap}</a>}
        {project.repo && <a href={project.repo}>{t.github}</a>}
      </p>
      <div class="prose">
        {project.body.map((paragraph) => <p>{paragraph}</p>)}
        {project.points.length > 0 && (
          <ul>
            {project.points.map((point) => <li>{point}</li>)}
          </ul>
        )}
      </div>
    </article>
  )
}
